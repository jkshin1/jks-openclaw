{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 2000000
  },
  "output": {
    "filePath": "reports/repomix/personal-edge-review.xml",
    "style": "xml",
    "filePathStyle": "target-relative",
    "parsableStyle": true,
    "compress": false,
    "headerText": "Privacy-sanitized review bundle for Personal Edge Agent. Review the current working-tree snapshot, including uncommitted and untracked source files. Source comments, tests, dependency locks, verification metadata, Room schemas, manifests, resources, scripts, and project evidence documents are intentionally retained. Generated outputs, raw device evidence, the model binary, credentials, and signing material are intentionally excluded. See the embedded review instructions for trust boundaries and evidence rules.",
    "instructionFilePath": "docs/REPOMIX_REVIEW_GUIDE.md",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": true,
    "truncateBase64": true,
    "copyToClipboard": false,
    "topFilesLength": 25,
    "tokenCountTree": 2500,
    "includeEmptyDirectories": false,
    "includeFullDirectoryStructure": false,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100,
      "includeDiffs": false,
      "includeLogs": false,
      "includeLogsCount": 1
    }
  },
  "include": [
    ".editorconfig",
    ".gitignore",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "gradlew",
    "**/*.bat",
    "**/*.json",
    "**/*.kt",
    "**/*.kts",
    "**/*.lockfile",
    "**/*.md",
    "**/*.pro",
    "**/*.properties",
    "**/*.sh",
    "**/*.toml",
    "**/*.xml",
    "**/*.yaml",
    "**/*.yml"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".agents/**",
      ".android-sdk/**",
      ".codex/**",
      ".gradle/**",
      ".idea/**",
      ".jdk/**",
      ".kotlin/**",
      "**/build/**",
      "captures/**",
      "reports/**",
      "traces/**",
      "local.properties",
      "**/.env",
      "**/.env.*",
      "**/*.jks",
      "**/*.keystore",
      "**/*.p12",
      "**/*.pfx",
      "**/*.pem",
      "**/*.key",
      "**/key.properties",
      "**/keystore.properties",
      "**/secrets.properties",
      "**/google-services.json",
      "**/credentials*.json",
      "**/service-account*.json",
      "**/client_secret*.json",
      "models/**/*.litertlm",
      "models/**/*.safetensors",
      "models/**/*.task",
      "**/*.aab",
      "**/*.apk",
      "**/*.db",
      "**/*.hprof",
      "**/*.jsonl",
      "**/*.log",
      "**/*.sqlite",
      "**/*.sqlite3",
      "**/repomix-output.*",
      "**/repomix-review*.xml"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
