<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Declared for the test APK only. The library itself stays permission-free so a consuming
        app decides which capabilities it actually requests; the app module declares these.
        grantRuntimePermission can only grant a permission the manifest declares.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Mirrors the app manifest so clockAppAvailable() is measured under real visibility rules. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
    </queries>

</manifest>
